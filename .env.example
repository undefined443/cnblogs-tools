# Cnblogs login username (may differ from the blog name).
CNBLOGS_USERNAME="your_login_username"

# MetaWeblog access token from https://i.cnblogs.com/settings#enableServiceAccess
CNBLOGS_TOKEN="your_metaweblog_access_token"

# Blog name from https://www.cnblogs.com/your_blog_name/
CNBLOGS_BLOG_NAME="your_blog_name"

# Optional: full endpoint; overrides CNBLOGS_BLOG_NAME.
# CNBLOGS_URL="https://rpc.cnblogs.com/metaweblog/your_blog_name"

# Optional: hosting base URL required by the images command.
# ENDPOINT="https://your-image-host.example.com"
